rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account's profiles and saves: only that account can read or write them.
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Public friend cards, one per sub-profile, addressed by friend code.
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Lifegram: everyone signed in reads, each player writes only their own doc.
    match /gram/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
